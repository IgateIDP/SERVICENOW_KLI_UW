        <name>kotak_validations</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var kotak_validations = Class.create();
kotak_validations.prototype = {
    initialize: function() {
    },

	loan_number_records : function(policySys){

		var lnRecords = [];

		var uwCase = new GlideRecord("x_rptp_kotak_uw_case");
		uwCase.addQuery("policy_id", policySys);
		uwCase.query();

		while(uwCase.next()){
			lnRecords.push(uwCase.getValue("loan_number"));
		}

		return 'sys_idIN' + lnRecords;
	},

	member_dep_records : function(policySys,loanSys){

		var memRecords = [];

		var uwCase = new GlideRecord("x_rptp_kotak_uw_case");
		uwCase.addQuery("policy_id", policySys);
		uwCase.addQuery("loan_number", loanSys);
		uwCase.query();

		while(uwCase.next()){
			memRecords.push(uwCase.getValue("consumer_id"));
		}

		return 'sys_idIN' + memRecords;
	},

    type: 'kotak_validations'
};]]></script>
