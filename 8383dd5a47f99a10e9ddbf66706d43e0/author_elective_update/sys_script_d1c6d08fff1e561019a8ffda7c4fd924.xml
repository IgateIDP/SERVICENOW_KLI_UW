        <script><![CDATA[
(function executeRule(current, previous /*null when async*/) {
    if (current.classification === 'Additional') {
        var gr = new GlideRecord('x_rptp_kotak_uw_case');
        if (gr.get(current.case_id)) { // Use get() for direct retrieval by sys_id
            if (gr.type_of_case !== 'rework') { // Avoid unnecessary updates
                gr.setValue('type_of_case', 'rework');
                gr.update();
            }
        } else {
            gs.addErrorMessage('No matching case found for sys_id: ' + current.case_id, 'Case Update');
        }
    }
})(current, previous);

]]></script>
