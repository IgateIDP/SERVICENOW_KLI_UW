    <sys_script_include action="DELETE">
        <access>package_private</access>
        <active>true</active>
        <api_name>x_rptp_kotak.KotakUWWorkbench</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>All the Server side requirements on the Workspace of UW are dumped here</description>
        <mobile_callable>false</mobile_callable>
        <name>KotakUWWorkbench</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var KotakUWWorkbench = Class.create();
KotakUWWorkbench.prototype = {
    initialize: function() {},
    fetchLatestDecisionRecord: function(case_id) {
        var decTab = new GlideRecord('x_rptp_kotak_underwriter_decision');
        decTab.addQuery('case_id', case_id);
        decTab.orderByDesc('sys_created_on'); // Fetch the latest record
        decTab.query();
        if (decTab.next()) {
            // Return all the field values in an object
            return {
                emr_decision: decTab.getValue('emr_decision'),
                per_millie: decTab.getValue('per_millie'),
                remarks: decTab.getValue('remarks'),
                emr: decTab.getValue('emr'),
                reason: decTab.getValue('reason'),
                final_remarks: decTab.getValue('final_remarks'),
                reduced_cover_term: decTab.getValue('reduced_cover_term'),
                comments: decTab.getValue('comments'),
                hold_internal_requirement: decTab.getValue('hold_internal_requirement'),
                reduced_sum_assured: decTab.getValue('reduced_sum_assured')
            };
        }
        return null; // No record found
    },



    type: 'KotakUWWorkbench'
};]]></script>
