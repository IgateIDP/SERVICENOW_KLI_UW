        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var sys = current.case_id;
    var gr = new GlideRecord('x_rptp_kotak_requirement_mapping');
    gr.addQuery('case_id', sys);
    gr.query();

    var allStatusValid = true; 
    while (gr.next()) {
      
        if (gr.getValue('status') !== 'R' && gr.getValue('status') !== 'W') {
            allStatusValid = false;
            break;
        }
    }

    
    var gr1 = new GlideRecord('x_rptp_kotak_uw_case');
    if (gr1.get(sys)) { 
        if (allStatusValid) {
            gr1.setValue('u_case_stage', 'uw_workbench_menu'); 
            gr1.setValue('case_status', '1'); 
        } else {
            gr1.setValue('u_case_stage', 'pending_requirements_menu'); 
        }
        gr1.update(); 
    }

})(current, previous);
]]></script>
