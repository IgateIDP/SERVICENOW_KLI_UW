        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var audit = new GlideRecord('x_rptp_kotak_kotak_audit_trail');
    audit.initialize();
	
    var UW = '';
    if (current.getValue('case_status') == '1') {
        UW = 'Primary UW';
    } else if (current.getValue('case_status') == '2') {
        UW = 'Secondary UW';
    } else {
        UW = 'Senior UW';
    }

    audit.setValue('case_id', current.sys_id);
    audit.setValue('activity', UW + ' has given the decision: ' + current.getValue('decision'));
    audit.insert();

})(current, previous);
]]></script>
