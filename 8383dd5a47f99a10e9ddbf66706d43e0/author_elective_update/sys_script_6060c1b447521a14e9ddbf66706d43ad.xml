        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var gr = new GlideRecord('x_rptp_kotak_requirement_mapping_list');
    gr.addQuery('case_id', current.sys_id);
    gr.query();

    var hasMedical = false;
    var hasNonMedical = false;

    while (gr.next()) {
		gs.addErrorMessage('dskjhalh');
        var type = gr.requirement_id.type.toString(); 
        if (type === 'medical') {
            hasMedical = true;
        } else if (type === 'non_medical') {
            hasNonMedical = true;
        }

       
        if (hasMedical && hasNonMedical) {
            break;
        }
    }
    if (hasMedical) {
        current.case_type = '1'; 
    } else if (hasNonMedical) {
        current.case_type = '2';
    }

})(current, previous);
]]></script>
