        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var openReqs = [];

    var reqMap = new GlideRecord("x_rptp_kotak_requirement_mapping");
    reqMap.addQuery("case_id", current.case_id);
    reqMap.addQuery("status", "O");
    reqMap.addQuery("requirement_id.type", "medical");
    reqMap.query();

    while (reqMap.next()) {

        var req = reqMap.getDisplayValue("requirement_id");
        openReqs.push(req);
    }

    var uwCase = new GlideRecord("x_rptp_kotak_uw_case");
    uwCase.addQuery("sys_id", current.case_id);
    uwCase.query();

    if (uwCase.next()) {

        uwCase.setValue("requirement_ids", openReqs.join(","));
        uwCase.update();

    }

})(current, previous);]]></script>
