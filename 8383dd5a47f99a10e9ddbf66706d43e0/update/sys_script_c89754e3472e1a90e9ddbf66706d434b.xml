        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var receivedDate = current.recieved_date;
    var uploadDate = current.upload_date;

    var received = new GlideDateTime(receivedDate);
    var upload = new GlideDateTime(uploadDate);

    var duration = GlideDateTime.subtract(received, upload);

    // Convert duration to days (duration is in milliseconds)
    var diffDays = Math.floor(duration.getDayPart());
	
	current.ageing_2 = diffDays;
	current.update();


})(current, previous);]]></script>
