        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var receivedDate = current.recieved_date;
    var raisedDate = current.raised_date;

    // Convert the date fields to Date objects
    var received = new GlideDateTime(receivedDate);
    var raised = new GlideDateTime(raisedDate);

	gs.addInfoMessage(received + "----"+ raised);

    // Calculate the difference in milliseconds
    var diffMilliseconds = received.getNumericValue() - raised.getNumericValue();

	gs.addInfoMessage(diffMilliseconds);

    // Convert milliseconds to days (1 day = 24 hours * 60 minutes * 60 seconds * 1000 milliseconds)
    var diffDays = diffMilliseconds / (1000 * 60 * 60 * 24);

	gs.addInfoMessage(diffDays);

    // Store the absolute difference (optional if you want to avoid negative values)
    //current.ageing_1 = Math.abs(diffDays); // You can remove Math.abs() if negative values are acceptable
    current.ageing_1 = diffDays;
    current.update();


})(current, previous);]]></script>
