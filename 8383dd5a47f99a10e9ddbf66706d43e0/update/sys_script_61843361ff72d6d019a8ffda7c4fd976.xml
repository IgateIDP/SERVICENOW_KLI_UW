        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var sumAss = current.sum_assured;
    current.recommended_assignment_group = getRecommendedGroup(sumAss);
    current.update()


    function getRecommendedGroup(sumAssured) {
        var targetSum = sumAssured; // Default to 1,500,000 if not provided

        var gr = new GlideRecord('sys_user_group'); // Replace with your actual table name
        gr.addQuery('u_uw_decision_limit_max', '>', targetSum); // Senior UW sum assured greater than target
        gr.orderBy('u_snr_uw'); // Closest higher value
        gr.query();

        if (gr.next()) {
            return gr.getValue('sys_id');
        }

    }

})(current, previous);]]></script>
