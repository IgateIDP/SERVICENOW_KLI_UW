        <script><![CDATA[var kli_task = Class.create();
kli_task.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    getTaskDetails: function() {
        var sysId = this.getParameter('sys_id');  // Get the passed sys_id
        var gr = new GlideRecord('');
        if (gr.get(sysId)) {
            return JSON.stringify({
                number: gr.getValue('number'),
                short_description: gr.getValue('short_description'),
                sys_id: gr.getValue('sys_id')
            });
        }
        return JSON.stringify({ error: 'Record not found or invalid sys_id' });
    },

    type: 'kli_task'
});
]]></script>
