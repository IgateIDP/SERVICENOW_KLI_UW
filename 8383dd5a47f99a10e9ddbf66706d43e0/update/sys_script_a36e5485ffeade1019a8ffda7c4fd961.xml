        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

   
    var hasMedical = false;
    var allNonMedical = true;

    
    var gr = new GlideRecord('x_rptp_kotak_requirement_mapping');
    gr.addQuery('case_id', current.case_id);
    gr.query();
    while (gr.next()) {
        var type = gr.requirement_id.type + '';

        if (type === 'medical') {
            hasMedical = true;
            allNonMedical = false;
            break;
        } else if (type !== 'non_medical') {
            allNonMedical = false;
        }
    }
    var gr1 = new GlideRecord('x_rptp_kotak_uw_case');
    if (gr1.get(current.case_id)) { 
        if (hasMedical) {
            gr1.setValue('case_type', 'medical');
            gs.addErrorMessage('Case type set to: medical');
        } else if (allNonMedical) {
            gr1.setValue('case_type', 'non_medical');
            gs.addErrorMessage('Case type set to: non-medical');
        }
        gr1.update(); 
    } else {
        gs.addErrorMessage('No case record found for sys_id: ' + current.case_id);
    }

})(current, previous);
]]></script>
