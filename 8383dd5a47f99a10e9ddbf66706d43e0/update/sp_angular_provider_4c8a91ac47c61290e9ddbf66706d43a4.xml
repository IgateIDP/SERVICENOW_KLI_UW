    <sp_angular_provider action="INSERT_OR_UPDATE">
        <name>customSpVariable</name>
        <script><![CDATA[function(spVariableLayoutDirective) {
	console.log(spVariableLayoutDirective);
	return angular.extend({}, spVariableLayoutDirective[0], {
		templateUrl: 'customVariableLayoutss.xml',

		controller: ['$scope', function($scope) {
			$scope.toggleCollapse = function(container) {
				angular.forEach($scope.containers, function(c) {
					if (c !== container) {
						c.isCollapsed = true;
					}
				});

				// Toggle the clicked section
				container.isCollapsed = !container.isCollapsed;
			};
		}]



	});
}]]></script>
