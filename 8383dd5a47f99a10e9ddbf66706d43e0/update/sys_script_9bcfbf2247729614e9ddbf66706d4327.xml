        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var sendDate = current.consent_send_date;
	var raisedDate = current.consent_start_date;

    var send = new GlideDateTime(sendDate);
	var raised = new GlideDateTime(raisedDate);
   
    var duration = GlideDateTime.subtract(raised, send);

    // Convert duration to days (duration is in milliseconds)
    var diffDays = Math.floor(duration.getDayPart());
	
	current.consent_sent_ageing = diffDays;
	current.update();

})(current, previous);]]></script>
