        <name>Ageing 2 - Req Submission ageing - Kotak</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   //Type appropriate comment here, and begin script below

   var receivedDate = g_form.getValue('recieved_date');
    var uploadDate = g_form.getValue('upload_date');

	//alert(receivedDate + "----"+ uploadDate);

    if (receivedDate && uploadDate) {
        
        var received = new Date(receivedDate);
		var upload = new Date(uploadDate);

		//alert(receive + "----"+ upload);

		//var timeDiff = Math.abs(received - upload);

        var timeDiff = upload - received;

        // Convert milliseconds to days (1 day = 24 hours * 60 minutes * 60 seconds * 1000 milliseconds)
        var diffDays =  timeDiff / (1000 * 3600 * 24);

        // Round the result to remove decimal points (optional)
        diffDays = Math.abs(Math.round(diffDays)); // Optional: Use Math.abs() to avoid negative days

        g_form.setValue('ageing_2', diffDays);
    }

    // Return true to allow the form submission
    return true;
   
}]]></script>
